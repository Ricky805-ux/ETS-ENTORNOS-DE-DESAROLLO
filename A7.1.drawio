<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/144.0.0.0 Safari/537.36" version="28.2.9">
  <diagram name="Página-1" id="d6qOl0RuthBuMbFzhjK9">
    <mxGraphModel dx="1678" dy="874" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;h2&gt;&lt;strong&gt;1. Grafo para &lt;code&gt;if (a &amp;amp;&amp;amp; b)&lt;/code&gt;&lt;/strong&gt;&lt;/h2&gt;&lt;br&gt;&lt;pre&gt;&lt;code&gt; ┌──────────────┐&lt;br&gt; │   Inicio      │&lt;br&gt; └───────┬──────┘&lt;br&gt;         ↓&lt;br&gt;   ┌──────────────┐&lt;br&gt;   │   a &amp;amp;&amp;amp; b ?    │◄─── Rombo (Decision)&lt;br&gt;   └───┬─────┬────┘&lt;br&gt;       │true │false&lt;br&gt;       ↓     ↓&lt;br&gt; ┌────────┐  ┌──────────────┐&lt;br&gt; │ doS()  │  │     c ?       │◄─── Otro rombo&lt;br&gt; └────┬───┘  └──────┬────────┘&lt;br&gt;      │             │true&lt;br&gt;      │             ↓&lt;br&gt;      │      ┌──────────────┐&lt;br&gt;      │      │ doSthElse()   │&lt;br&gt;      │      └──────┬────────┘&lt;br&gt;      │false         │&lt;br&gt;      ↓              ↓&lt;br&gt;   ┌────────────────────┐&lt;br&gt;   │        Fin          │&lt;br&gt;   └────────────────────┘&lt;br&gt;&lt;/code&gt;&lt;/pre&gt;&lt;br&gt;&lt;hr&gt;&lt;br&gt;&lt;h2&gt;&lt;strong&gt;2. Grafo para &lt;code&gt;if (a || b)&lt;/code&gt;&lt;/strong&gt;&lt;/h2&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;br&gt;&lt;pre&gt;&lt;code&gt; ┌──────────────┐&lt;br&gt; │   Inicio      │&lt;br&gt; └───────┬──────┘&lt;br&gt;         ↓&lt;br&gt;   ┌──────────────┐&lt;br&gt;   │   a || b ?    │&lt;br&gt;   └───┬─────┬────┘&lt;br&gt;       │true │false&lt;br&gt;       ↓     ↓&lt;br&gt; ┌────────┐  ┌──────────────┐&lt;br&gt; │ doS()  │  │     c ?       │&lt;br&gt; └────┬───┘  └──────┬────────┘&lt;br&gt;      │             │true&lt;br&gt;      │             ↓&lt;br&gt;      │      ┌──────────────┐&lt;br&gt;      │      │ doSthElse()   │&lt;br&gt;      │      └──────┬────────┘&lt;br&gt;      │false         │&lt;br&gt;      ↓              ↓&lt;br&gt;   ┌────────────────────┐&lt;br&gt;   │        Fin          │&lt;br&gt;   └────────────────────┘&lt;br&gt;&lt;/code&gt;&lt;/pre&gt;&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" link="&lt;p&gt;Claro, Ricardo. Si lo que quieres es &lt;strong&gt;ver cómo debe quedar visualmente el diagrama en draw.io&lt;/strong&gt;, puedo mostrarte una &lt;strong&gt;representación esquemática&lt;/strong&gt; que te sirva como guía para dibujarlo allí.&lt;/p&gt;&#xa;&lt;p&gt;No puedo generar imágenes reales aquí, pero sí puedo darte un &lt;strong&gt;modelo visual&lt;/strong&gt; muy parecido al que verás en draw.io.&lt;/p&gt;&#xa;&lt;hr&gt;&#xa;&lt;h1&gt;🖼️ &lt;strong&gt;Guía visual para dibujarlo en draw.io&lt;/strong&gt;&lt;/h1&gt;&#xa;&lt;h2&gt;&lt;strong&gt;1. Grafo para &lt;code&gt;if (a &amp;amp;&amp;amp; b)&lt;/code&gt;&lt;/strong&gt;&lt;/h2&gt;&#xa;&lt;pre&gt;&lt;code&gt; ┌──────────────┐&#xa; │   Inicio      │&#xa; └───────┬──────┘&#xa;         ↓&#xa;   ┌──────────────┐&#xa;   │   a &amp;amp;&amp;amp; b ?    │◄─── Rombo (Decision)&#xa;   └───┬─────┬────┘&#xa;       │true │false&#xa;       ↓     ↓&#xa; ┌────────┐  ┌──────────────┐&#xa; │ doS()  │  │     c ?       │◄─── Otro rombo&#xa; └────┬───┘  └──────┬────────┘&#xa;      │             │true&#xa;      │             ↓&#xa;      │      ┌──────────────┐&#xa;      │      │ doSthElse()   │&#xa;      │      └──────┬────────┘&#xa;      │false         │&#xa;      ↓              ↓&#xa;   ┌────────────────────┐&#xa;   │        Fin          │&#xa;   └────────────────────┘&#xa;&lt;/code&gt;&lt;/pre&gt;&#xa;&lt;hr&gt;&#xa;&lt;h2&gt;&lt;strong&gt;2. Grafo para &lt;code&gt;if (a || b)&lt;/code&gt;&lt;/strong&gt;&lt;/h2&gt;&#xa;&lt;p&gt;Es exactamente igual, solo cambia el texto del primer rombo:&lt;/p&gt;&#xa;&lt;pre&gt;&lt;code&gt; ┌──────────────┐&#xa; │   Inicio      │&#xa; └───────┬──────┘&#xa;         ↓&#xa;   ┌──────────────┐&#xa;   │   a || b ?    │&#xa;   └───┬─────┬────┘&#xa;       │true │false&#xa;       ↓     ↓&#xa; ┌────────┐  ┌──────────────┐&#xa; │ doS()  │  │     c ?       │&#xa; └────┬───┘  └──────┬────────┘&#xa;      │             │true&#xa;      │             ↓&#xa;      │      ┌──────────────┐&#xa;      │      │ doSthElse()   │&#xa;      │      └──────┬────────┘&#xa;      │false         │&#xa;      ↓              ↓&#xa;   ┌────────────────────┐&#xa;   │        Fin          │&#xa;   └────────────────────┘&#xa;&lt;/code&gt;&lt;/pre&gt;&#xa;&lt;hr&gt;&#xa;&lt;h1&gt;🧭 &lt;strong&gt;Cómo usar esta guía en draw.io&lt;/strong&gt;&lt;/h1&gt;&#xa;&lt;ol&gt;&#xa;&lt;li&gt;Abre draw.io&lt;/li&gt;&#xa;&lt;li&gt;Inserta las figuras:&#xa;&lt;ul&gt;&#xa;&lt;li&gt;&lt;strong&gt;Rombo&lt;/strong&gt; para decisiones (&lt;code&gt;a &amp;amp;&amp;amp; b&lt;/code&gt;, &lt;code&gt;c&lt;/code&gt;)&lt;/li&gt;&#xa;&lt;li&gt;&lt;strong&gt;Rectángulo redondeado&lt;/strong&gt; para Inicio y Fin&lt;/li&gt;&#xa;&lt;li&gt;&lt;strong&gt;Rectángulo&lt;/strong&gt; para acciones (&lt;code&gt;doSomething()&lt;/code&gt;, &lt;code&gt;doSthElse()&lt;/code&gt;)&lt;/li&gt;&#xa;&lt;/ul&gt;&#xa;&lt;/li&gt;&#xa;&lt;li&gt;Conecta con flechas siguiendo el esquema.&lt;/li&gt;&#xa;&lt;/ol&gt;&#xa;&lt;hr&gt;&#xa;&lt;p&gt;Si quieres, puedo generarte &lt;strong&gt;una versión más compacta&lt;/strong&gt;, o ayudarte a &lt;strong&gt;dibujarlo paso a paso&lt;/strong&gt; dentro de draw.io.&lt;/p&gt;" id="sBvLyh1Z6kxIXbJcvxS0-5">
          <mxCell style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
            <mxGeometry x="240" y="210" width="560" height="1640" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
